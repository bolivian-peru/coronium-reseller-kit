# Your Coronium API key (JWT). Get it from https://dashboard.coronium.io → Settings → API.
# This stays server-side — never exposed to the browser.
CORONIUM_API_KEY=

# Required operator-only login. Serve over HTTPS outside localhost.
RESELLER_ADMIN_USER=
RESELLER_ADMIN_PASSWORD=

# Base URL for the Coronium API. Default is production; override only if testing
# against a different environment.
CORONIUM_API_BASE=https://api.coronium.io/api/v3

# Public HTTPS URL of this self-hosted dashboard, used for webhook registration.
RESELLER_PUBLIC_URL=

# Required: Coronium's webhook signing secret. Unsigned events are rejected.
CORONIUM_WEBHOOK_SECRET=

# Optional local URL for the durable inbox worker (defaults to localhost:3000).
RESELLER_INTERNAL_URL=http://127.0.0.1:3000
