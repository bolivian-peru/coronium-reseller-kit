# Your Coronium API key (JWT). Get it from https://dashboard.coronium.io → Settings → API.
# This stays server-side — never exposed to the browser.
CORONIUM_API_KEY=

# Base URL for the Coronium API. Default is production; override only if testing
# against a different environment.
CORONIUM_API_BASE=https://api.coronium.io/api/v3

# The public URL of THIS reseller dashboard. Used to register the webhook
# with Coronium on first deploy. Example: https://my-reseller-shop.vercel.app
# Leave empty in local dev.
RESELLER_PUBLIC_URL=

# Optional shared secret YOU append to your webhook URL as a query param, e.g.
# https://your-host/api/coronium/webhook?key=<this>. Coronium echoes back
# whatever URL you registered. Use crypto.randomBytes(32).toString('hex').
WEBHOOK_SECRET=

# Coronium's webhook signing secret — ask support for yours. When set, the
# webhook route verifies the X-Coronium-Signature header (sha256 HMAC of the
# raw body) and rejects anything unsigned. This is the real authentication;
# WEBHOOK_SECRET above is only obscurity.
CORONIUM_WEBHOOK_SECRET=
